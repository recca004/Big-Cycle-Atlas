# Big Cycle Atlas — environment variables
# Copy to .env (root), and to apps/api/.env and apps/web/.env.local as noted.

# --- Database (backend) -----------------------------------------------------
# Docker Compose builds this URL from the POSTGRES_* values below:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bigcycleatlas
# Copy this line into apps/api/.env
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bigcycleatlas

# Docker Compose PostgreSQL settings (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bigcycleatlas

# --- API (backend) -----------------------------------------------------------
# Base URL the frontend uses to reach the API.
# Copy this line into apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS origins accepted by the API (JSON list). Default: http://localhost:3000
# CORS_ORIGINS=["http://localhost:3000"]

# --- Future external data sources (do not fill in yet) -----------------------
# WORLDBANK_API_KEY=
# FRED_API_KEY=
# COMTRADE_API_KEY=