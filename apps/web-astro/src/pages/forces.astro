---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ForcesExplorer } from "@/features/forces/ForcesExplorer";
---

<BaseLayout title="Forces" fullWidth>
  <header class="page-header">
    <p class="label-md text-tertiary">The 17 Big Cycle forces</p>
    <h1 class="headline-lg">Forces</h1>
    <p class="body-sm">
      Force measurements are derived, never invented. Published levels,
      independent dimensions and context profiles are distinct implementation
      types — an unavailable country score is not a deferred force.
    </p>
  </header>
  <ForcesExplorer client:only="react" />
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-6); }
  .page-header h1 { margin-top: var(--space-2); }
  .page-header .body-sm { margin-top: var(--space-2); }
</style>
