---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { HistoricalPowerExplorer } from "@/features/research/HistoricalPowerExplorer";
---

<BaseLayout
  title="Historical Power Research"
  description="Long-run economic development (Maddison 1500–2022) and Penn World Table productivity — observational research, no composite power score"
  fullWidth
>
  <header class="page-header">
    <p class="label-md text-tertiary">Research module</p>
    <h1 class="headline-lg">Historical Power Research</h1>
    <p class="body-sm">
      Long-run GDP per capita and population from the Maddison Project (1500–2022)
      and Penn World Table 11.0 productivity (1950–2023). Modern country codes do
      not represent historical empires; panel shares are shares of the 20-entity
      imported panel, not world shares. GDP is kept separate from military,
      trade, institutional and monetary influence.
    </p>
  </header>
  <HistoricalPowerExplorer client:load />
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-6); }
  .page-header h1 { margin-top: var(--space-2); }
  .page-header .body-sm { margin-top: var(--space-2); max-width: 54rem; }
</style>
