---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { WatchlistPanel } from "@/features/watchlist/WatchlistPanel";
---

<BaseLayout title="Watchlist" fullWidth>
  <header class="page-header">
    <p class="label-md text-tertiary">Pinned references</p>
    <h1 class="headline-lg">Watchlist</h1>
    <p class="body-sm">
      Instruments, indicators, countries, forces and models pinned for
      quick access.
    </p>
  </header>
  <WatchlistPanel client:load />
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-6); }
  .page-header h1 { margin-top: var(--space-2); }
  .page-header .body-sm { margin-top: var(--space-2); }
  .research-controls { display: flex; gap: var(--space-4); align-items: center; padding: var(--space-4); flex-wrap: wrap; }
  .panel-title { margin-bottom: var(--space-3); }
  .glass { margin-bottom: var(--space-5); }
</style>
