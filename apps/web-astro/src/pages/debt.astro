---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DomainForces } from "@/features/site/SitePanels";
---

<BaseLayout title="Debt">
  <header class="page-header">
    <p class="label-md text-tertiary">Debt &amp; capital</p>
    <h1 class="headline-lg">Debt</h1>
    <p class="body-sm">
      Indebtedness and capital-flow forces. Indebtedness is executable via
      CONDITION_MINUS_PENALTY (DEC-040, provisional — owner ratification
      pending).
    </p>
  </header>
  <DomainForces
    client:load
    forceCodes={["indebtedness", "trade_capital_flows", "internal_conflict"]}
    indicators={["DEBT_SERVICE_RATIO", "CREDIT_TO_GDP_GAP", "GOVERNMENT_DEBT_GDP"]}
  />
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-6); }
  .page-header h1 { margin-top: var(--space-2); }
  .page-header .body-sm { margin-top: var(--space-2); }
</style>
