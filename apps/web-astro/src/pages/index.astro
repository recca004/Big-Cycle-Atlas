---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ObservatoryApp } from "@/features/observatory/ObservatoryApp";
---

<BaseLayout title="Great Power Observatory" fullWidth>
  <header class="obs-hero">
    <div>
      <p class="wordmark-name obs-hero-kicker">Big Cycle Atlas · Observatory</p>
      <h1 class="headline-display">Where does each power sit on the Big Cycle?</h1>
    </div>
    <p class="body-md obs-hero-sub">
      The clock places every tracked country on the rise → peak → decline
      dial using the 17 Atlas forces — experimental composite models over
      public data, with every gate and caveat in the open.
    </p>
  </header>
  <ObservatoryApp client:load />
</BaseLayout>

<style>
  .obs-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-10);
    padding: var(--space-8) 0 var(--space-8);
    flex-wrap: wrap;
  }
  .obs-hero-kicker {
    font-size: 0.7rem;
    margin-bottom: var(--space-4);
  }
  .obs-hero h1 {
    margin: 0;
    max-width: 38rem;
  }
  .obs-hero-sub {
    max-width: 30rem;
    color: var(--text-secondary);
    margin: 0;
  }
</style>
