---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SettingsPanel } from "@/features/site/SitePanels";
---

<BaseLayout title="Settings">
  <header class="page-header">
    <p class="label-md text-tertiary">Preferences</p>
    <h1 class="headline-lg">Settings</h1>
  </header>
  <SettingsPanel client:load />
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-6); }
  .page-header h1 { margin-top: var(--space-2); }
</style>
