# Big Cycle Atlas API — local development environment.
# Copy to .env and adjust. Never commit a filled .env.

# PostgreSQL DSN (async psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bigcycleatlas_dev

# CORS origins as JSON list (the Astro dev server)
CORS_ORIGINS=["http://localhost:3000"]

# Optional: override the seed catalog path (auto-resolved in repo layout)
# BCA_SEED_FILE=../../packages/shared/data/initial-countries.json
