# Big Cycle Atlas — production compose environment.
# Copy to .env and change the password before `docker compose up -d`.

POSTGRES_USER=bca
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bigcycleatlas
WEB_PORT=8080
BIND_ADDR=127.0.0.1

# BIND_ADDR=127.0.0.1 keeps the app local-only. For private-network access
# put it behind an authenticated reverse proxy and set BIND_ADDR to your
# LAN interface — never expose unauthenticated mutation endpoints publicly.
