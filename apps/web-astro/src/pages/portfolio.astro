---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PortfolioPanel } from "@/features/portfolio/PortfolioPanel";
---

<BaseLayout title="Portfolio">
  <header class="page-header">
    <p class="label-md text-tertiary">Simulation only</p>
    <h1 class="headline-lg">Paper Portfolio</h1>
    <p class="body-sm">
      A deterministic simulation ledger over stored market prices. No real
      money, no brokerage connection, no order routing — every number is
      labelled simulation.
    </p>
  </header>
  <PortfolioPanel client:load />
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-6); }
  .page-header h1 { margin-top: var(--space-2); }
  .page-header .body-sm { margin-top: var(--space-2); }
  .research-controls { display: flex; gap: var(--space-4); align-items: center; padding: var(--space-4); flex-wrap: wrap; }
  .panel-title { margin-bottom: var(--space-3); }
  .glass { margin-bottom: var(--space-5); }
</style>
