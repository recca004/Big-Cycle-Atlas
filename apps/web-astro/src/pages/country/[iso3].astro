---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CountryProfile } from "@/features/country/CountryProfile";
import { INITIAL_COUNTRIES } from "@big-cycle-atlas/shared";

export function getStaticPaths() {
  return INITIAL_COUNTRIES.map((c) => ({ params: { iso3: c.iso3 } }));
}

const { iso3 } = Astro.params;
const country = INITIAL_COUNTRIES.find((c) => c.iso3 === iso3);
---

<BaseLayout title={country?.name ?? iso3} fullWidth>
  <header class="page-header">
    <p class="label-md text-tertiary">
      Country · {iso3}{country ? ` · ${country.region}` : ""}
    </p>
    <h1 class="headline-lg">{country?.name ?? iso3}</h1>
  </header>
  <CountryProfile iso3={iso3} client:load />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-8);
  }
  .page-header h1 {
    margin-top: var(--space-2);
  }
</style>
