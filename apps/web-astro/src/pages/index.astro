---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { BigCycleClock } from "@/features/observatory/BigCycleClock";
---

<BaseLayout title="Great Power Observatory">
  <section class="hero">
    <p class="wordmark-name hero-kicker">Big Cycle Atlas · Observatory</p>
    <h1 class="headline-display">Where does each power sit on the Big Cycle?</h1>
    <p class="body-md hero-sub">
      The clock places every tracked country on the rise → peak → decline
      dial using the 17 Atlas forces — experimental composite models over
      public data, with every gate and caveat in the open.
    </p>
    <div class="hero-actions">
      <ButtonLink href="/forces">Study the 17 forces</ButtonLink>
      <ButtonLink href="/compare" variant="ghost">Compare powers</ButtonLink>
      <ButtonLink href="/research" variant="ghost">Research lab</ButtonLink>
    </div>
  </section>

  <section class="clock-section">
    <BigCycleClock client:load />
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-12) 0 var(--space-10);
    text-align: center;
  }
  .hero-kicker {
    font-size: 0.7rem;
  }
  .hero h1 {
    max-width: 44rem;
    margin: var(--space-6) auto 0;
  }
  .hero-sub {
    max-width: 34rem;
    margin: var(--space-8) auto 0;
    color: var(--text-secondary);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-10);
    flex-wrap: wrap;
    justify-content: center;
  }
  .clock-section {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-10) 0 var(--space-12);
  }
</style>
