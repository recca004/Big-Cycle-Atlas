---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { WorkspaceApp } from "@/features/workspace/WorkspaceApp";
---

<BaseLayout title="Workspace">
  <header class="page-header">
    <p class="label-md text-tertiary">Customisable dashboard</p>
    <h1 class="headline-lg">Workspace</h1>
    <p class="body-sm">
      Build your own research dashboard — drag, resize and configure widgets.
      Layouts are saved locally in your browser.
    </p>
  </header>
  <WorkspaceApp client:only="react" />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-6);
  }
  .page-header h1 {
    margin-top: var(--space-2);
  }
  .page-header .body-sm {
    margin-top: var(--space-2);
  }
</style>
