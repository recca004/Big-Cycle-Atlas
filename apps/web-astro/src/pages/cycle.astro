---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlassCard from "@/components/glass/GlassCard.astro";
import { CycleExplorer } from "@/features/research/CycleExplorer";

const PHASES = [
  { name: "RISE", stages: ["EARLY_RISE", "RISE", "LATE_RISE"],
    desc: "Conditions and relative position improving across measurable domains." },
  { name: "PEAK", stages: ["PEAK", "LATE_PEAK"],
    desc: "Conditions at or near historical highs; momentum decelerating." },
  { name: "DECLINE", stages: ["EARLY_DECLINE", "DECLINE", "RESET"],
    desc: "Conditions deteriorating; RESET marks a discontinuity after stress." },
];
---

<BaseLayout title="Big Cycle" fullWidth>
  <header class="page-header">
    <p class="label-md text-tertiary">Big Cycle explorer</p>
    <h1 class="headline-lg">Big Cycle</h1>
    <p class="body-sm">
      Two separate views: the <strong>conceptual framework</strong> (a model
      of how national conditions evolve — not a calculated result) and the
      <strong>experimental engine output</strong> (computed in Python through
      the research API from real force measurements).
    </p>
  </header>

  <GlassCard>
    <h2 class="headline-sm">Conceptual framework</h2>
    <p class="body-sm">
      Three public phases decompose into eight internal stages. The diagram is
      conceptual — a country does not necessarily follow this exact path, and
      no country marker is placed on it without a valid model result.
    </p>
    <div class="phase-grid">
      {PHASES.map((p) => (
        <div class="phase-card glass-subtle">
          <h3 class="headline-sm">{p.name}</h3>
          <p class="body-sm">{p.desc}</p>
          <p class="label-md text-tertiary">{p.stages.join(" → ")}</p>
        </div>
      ))}
    </div>
    <p class="body-sm">
      Measurement limits: composite conditions use only compatible force
      dimensions; own-history conditions, descriptive shares and structural
      context are excluded from 0–100 composition rather than forced in.
    </p>
  </GlassCard>

  <section aria-label="Experimental cycle explorer">
    <CycleExplorer client:load />
  </section>

  <GlassCard>
    <h2 class="headline-sm">Production status</h2>
    <p class="body-sm">
      There is no approved production cycle score. The classifications above
      are experimental and retrospective (backtest_safe=false): input
      observations are not yet restricted to information genuinely available
      at each historical scoring date, so retrospective classifications may
      embed information published later than the scored period. Approved
      force scores remain available on each country's page and are unaffected
      by this research.
    </p>
  </GlassCard>
</BaseLayout>

<style>
  .page-header { margin-bottom: var(--space-6); }
  .page-header h1 { margin-top: var(--space-2); }
  .page-header .body-sm { margin-top: var(--space-2); }
  .phase-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin: var(--space-4) 0;
  }
  .phase-card h3 { margin-bottom: var(--space-2); }
  .phase-card p { margin-bottom: var(--space-2); }
  section { margin: var(--space-6) 0; }
</style>
